<Window x:Class="PR3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="/Resources/icon.png">
    <Grid>
        <Rectangle
            Height="60"
            Fill="LightGreen"
            VerticalAlignment="Top"/>

        <Image
            Width="55"
            Height="55"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="5,5,0,0"
            Source="/Resources/logo.png"/>

        <Button
            Name="btnBack"
            Click="BtnBack_Click"
            Content="Назад"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"/>

        <Frame Name="frame" Grid.Row="1" NavigationUIVisibility="Hidden" ContentRendered="Frame_ContentRendered"/>
    </Grid>
</Window>
